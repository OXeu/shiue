# 服务端配置示例。不要把真实密钥提交到 Git；生产值在 Vercel 控制台设置。
# 留言与友链申请共用以下配置，签名通过不同用途标识隔离。
COMMENTS_SITE_URL=https://blog.lab.xeu.life/
RESEND_API_KEY=
COMMENTS_EMAIL_FROM=
COMMENTS_EMAIL_TO=
# 只需生成一次：openssl rand -hex 32。Vercel 与 GitHub 的 COMMENTS_SECRET 设置相同值。
# 程序自动派生 PoW、审批、发布和邮箱加密所需的不同密钥。
COMMENTS_SECRET=
COMMENTS_POW_DIFFICULTY=5
COMMENTS_GITHUB_TOKEN=
COMMENTS_GITHUB_REPOSITORY=OXeu/shiue
COMMENTS_GITHUB_BRANCH=master
# 以下只用于 Vercel 每日自动部署；评论 CI 不需要，也无需复制到 GitHub Secrets。
CRON_SECRET=
VERCEL_DEPLOY_HOOK_URL=
