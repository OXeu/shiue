{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node scripts/vercel-install.mjs",
  "buildCommand": "npm run deploy",
  "outputDirectory": "public",
  "functions": {
    "api/daily-deploy.js": { "maxDuration": 30 },
    "api/comments-challenge.js": { "maxDuration": 15, "includeFiles": "public/comment-pages.json" },
    "api/comments-submit.js": { "maxDuration": 30, "includeFiles": "public/comment-pages.json" },
    "api/comments-approve.js": { "maxDuration": 30, "includeFiles": "public/comment-pages.json" },
    "api/friends-challenge.js": { "maxDuration": 15 },
    "api/friends-submit.js": { "maxDuration": 30 },
    "api/friends-approve.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(comment-review|friend-review)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/daily-deploy", "schedule": "17 3 * * *" }
  ]
}
